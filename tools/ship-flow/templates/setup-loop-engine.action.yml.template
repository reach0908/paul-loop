name: Setup loop-engine
description: >
  GitHub Actions is a plain shell process, outside the Claude Code plugin-cache mechanism entirely
  (plugin bin/ PATH registration and installed-path lookup assume a live Claude Code session). This
  action fetches loop-engine@paul-loop and ship-flow@paul-loop with independently reviewed commit pins and
  exports LOOP_ENGINE_PATH/SHIP_FLOW_PATH, so `plugin-path.mjs` (loop-engine's own bundled resolver,
  BAC-753) resolves them the same way it would a local env-var override. Any job that runs a verify
  command, a loop-engine bin script, or this repo's own selftest should call this action first.

  Select each plugin's release tag and full commit SHA deliberately during setup or update. Both
  clones must match their recorded SHA before checkout or downloaded code runs. A moved tag fails
  closed; never resolve a replacement expected SHA from the live remote during CI. The clone URL
  is the canonical repository, and the two plugins retain independent versions and directories.
runs:
  using: composite
  steps:
    - shell: bash
      env:
        LOOP_ENGINE_TAG: '{{LOOP_ENGINE_TAG}}'
        LOOP_ENGINE_COMMIT: '{{LOOP_ENGINE_COMMIT}}'
        SHIP_FLOW_TAG: '{{SHIP_FLOW_TAG}}'
        SHIP_FLOW_COMMIT: '{{SHIP_FLOW_COMMIT}}'
      run: |
        set -euo pipefail
        for tag in "$LOOP_ENGINE_TAG" "$SHIP_FLOW_TAG"; do
          [[ "$tag" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(\+[0-9A-Za-z.-]+)?$ ]] || { echo 'Invalid release tag' >&2; exit 1; }
        done
        for commit in "$LOOP_ENGINE_COMMIT" "$SHIP_FLOW_COMMIT"; do
          [[ "$commit" =~ ^[0-9a-f]{40}$ ]] || { echo 'Expected a reviewed full commit SHA' >&2; exit 1; }
        done
        setup_dir=$(mktemp -d "${RUNNER_TEMP:-${TMPDIR:-/tmp}}/paul-loop.XXXXXXXX")
        # Keep successful clones for later steps; on failure remove only this invocation's directory.
        trap 'rm -rf "$setup_dir"' ERR
        git clone --no-checkout --depth 1 --branch "loop-engine--$LOOP_ENGINE_TAG" \
          https://github.com/reach0908/paul-loop.git "$setup_dir/engine"
        git clone --no-checkout --depth 1 --branch "ship-flow--$SHIP_FLOW_TAG" \
          https://github.com/reach0908/paul-loop.git "$setup_dir/ship"
        # Authenticate both the selected HEAD and the peeled tag; --branch also accepts branch names.
        test "$(git -C "$setup_dir/engine" rev-parse --verify 'HEAD^{commit}')" = "$LOOP_ENGINE_COMMIT"
        test "$(git -C "$setup_dir/engine" rev-parse --verify "refs/tags/loop-engine--$LOOP_ENGINE_TAG^{commit}")" = "$LOOP_ENGINE_COMMIT"
        test "$(git -C "$setup_dir/ship" rev-parse --verify 'HEAD^{commit}')" = "$SHIP_FLOW_COMMIT"
        test "$(git -C "$setup_dir/ship" rev-parse --verify "refs/tags/ship-flow--$SHIP_FLOW_TAG^{commit}")" = "$SHIP_FLOW_COMMIT"
        # No checkout filters or downloaded executables run until both identities match.
        git -C "$setup_dir/engine" checkout --detach "$LOOP_ENGINE_COMMIT"
        git -C "$setup_dir/ship" checkout --detach "$SHIP_FLOW_COMMIT"
        # Validate the actual artifacts before exporting executable paths to subsequent steps.
        LOOP_RUNTIME=shell LOOP_ENGINE_PATH="$setup_dir/engine/tools/loop-engine" \
          node "$setup_dir/engine/tools/loop-engine/bin/plugin-path.mjs" resolve loop-engine
        LOOP_RUNTIME=shell SHIP_FLOW_PATH="$setup_dir/ship/tools/ship-flow" \
          node "$setup_dir/engine/tools/loop-engine/bin/plugin-path.mjs" resolve ship-flow
        echo "LOOP_RUNTIME=shell" >> "$GITHUB_ENV"
        echo "LOOP_ENGINE_PATH=$setup_dir/engine/tools/loop-engine" >> "$GITHUB_ENV"
        echo "SHIP_FLOW_PATH=$setup_dir/ship/tools/ship-flow" >> "$GITHUB_ENV"
